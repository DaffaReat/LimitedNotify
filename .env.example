# Polling schedule (cron format)
POLL_CRON_SCHEDULE="*/5 * * * *"

# Comma-separated list of Roblox Asset IDs
ASSET_IDS="4390890198"

# Target WhatsApp JID for notifications
OWNER_JID="628111441757@s.whatsapp.net"

# Path to the SQLite database file
# In production (e.g. Railway), this should point inside a mounted persistent volume, like /app/data/db.sqlite
DB_PATH="./db.sqlite"

# Directory where Baileys authentication state is stored
# In production (e.g. Railway), this should point inside a mounted persistent volume, like /app/data/auth
AUTH_DIR="./auth"
